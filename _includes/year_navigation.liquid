<div class="dropdown text-center">
    <button class="btn btn-sm z-depth-1 dropdown-toggle w-100" type="button" id="yearDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="color: #424242; border: 1px solid #ccc; background-color: white; height: 100%; display: flex; align-items: center; justify-content: center;">
      Jump to Year
    </button>
    <div class="dropdown-menu" aria-labelledby="yearDropdown" id="year-shortcuts-menu" style="max-height: 300px; overflow-y: auto; width: 100%;">
      <!-- Dropdown items injected here by JS -->
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
    const years = [];
    const menu = document.getElementById('year-shortcuts-menu');
    
    // Find all year headers generated by jekyll-scholar
    document.querySelectorAll('h2.bibliography').forEach(el => {
        const text = el.innerText.trim();
        // Check if text is exactly a 4-digit year
        if (/^\d{4}$/.test(text)) {
            years.push(text);
            // Ensure the header has an ID for scrolling
            if (!el.id) {
                el.id = 'year-' + text;
            }
        }
    });

    if (menu && years.length > 0) {
        years.forEach(year => {
            const item = document.createElement('a');
            item.className = 'dropdown-item';
            item.textContent = year;
            item.href = '#year-' + year;
            item.style.cursor = 'pointer';
            
            // Smooth scroll behavior
            item.addEventListener('click', function(e) {
                e.preventDefault();
                const target = document.getElementById('year-' + year);
                if (target) {
                    const headerOffset = 70; // Adjust for fixed navbar
                    const elementPosition = target.getBoundingClientRect().top;
                    const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
                    
                    window.scrollTo({
                        top: offsetPosition,
                        behavior: "smooth"
                    });
                }
            });

            menu.appendChild(item);
        });
    }
});
</script>
