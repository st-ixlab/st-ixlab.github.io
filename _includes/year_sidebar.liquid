<nav id="year-sidebar" class="sticky-top" style="top: 80px; padding-top: 20px;">
  <ul class="nav flex-column" id="year-sidebar-list">
    <!-- Links injected by JS -->
  </ul>
</nav>

<script>
document.addEventListener("DOMContentLoaded", function() {
    const list = document.getElementById('year-sidebar-list');
    const years = [];
    const cutoffYear = 2020; // Years <= this will be grouped
    let hasOlder = false;
    let oldestYearId = null;
    let hasUnderReview = false;
    let underReviewId = null;

    // First scan to find years
    document.querySelectorAll('h2.bibliography').forEach(el => {
        const text = el.innerText.trim();
        if (/^\d{4}$/.test(text)) {
            const year = parseInt(text);
            if (!el.id) {
                el.id = 'year-' + text;
            }

            if (year > cutoffYear) {
                years.push(year);
            } else {
                hasOlder = true;
                if (!oldestYearId) {
                    oldestYearId = 'year-' + text; // Point to the first (newest) of the old years
                }
            }
        } else if (text.toLowerCase() === 'under review') {
            hasUnderReview = true;
            if (!el.id) {
                el.id = 'year-under-review';
            }
            underReviewId = el.id;
        }
    });

    // Create links for recent years
    years.forEach(year => {
        const li = document.createElement('li');
        li.className = 'nav-item';
        
        const a = document.createElement('a');
        a.className = 'nav-link';
        a.href = '#year-' + year;
        a.textContent = year;
        a.style.color = 'var(--global-text-color-light)';
        
        // Active state style on hover
        a.addEventListener('mouseenter', () => a.style.color = 'var(--global-theme-color)');
        a.addEventListener('mouseleave', () => a.style.color = 'var(--global-text-color-light)');

        // Smooth scroll
         a.addEventListener('click', function(e) {
            e.preventDefault();
            const target = document.getElementById('year-' + year);
            if (target) {
                const headerOffset = 70;
                const elementPosition = target.getBoundingClientRect().top;
                const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
                window.scrollTo({ top: offsetPosition, behavior: "smooth" });
            }
        });

        li.appendChild(a);
        list.appendChild(li);
    });

    // Create "Before 2021" link
    if (hasOlder && oldestYearId) {
        const li = document.createElement('li');
        li.className = 'nav-item';
        
        const a = document.createElement('a');
        a.className = 'nav-link';
        a.href = '#' + oldestYearId;
        a.textContent = '~' + (cutoffYear + 1);
        a.style.color = 'var(--global-text-color-light)';
        
        a.addEventListener('mouseenter', () => a.style.color = 'var(--global-theme-color)');
        a.addEventListener('mouseleave', () => a.style.color = 'var(--global-text-color-light)');

         a.addEventListener('click', function(e) {
            e.preventDefault();
            const target = document.getElementById(oldestYearId);
            if (target) {
                const headerOffset = 70;
                const elementPosition = target.getBoundingClientRect().top;
                const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
                window.scrollTo({ top: offsetPosition, behavior: "smooth" });
            }
        });

        li.appendChild(a);
        list.appendChild(li);
    }

    // Create "Under Review" link
    if (hasUnderReview && underReviewId) {
        const li = document.createElement('li');
        li.className = 'nav-item';
        
        const a = document.createElement('a');
        a.className = 'nav-link';
        a.href = '#' + underReviewId;
        a.textContent = 'Under Review';
        a.style.color = 'var(--global-text-color-light)';
        
        a.addEventListener('mouseenter', () => a.style.color = 'var(--global-theme-color)');
        a.addEventListener('mouseleave', () => a.style.color = 'var(--global-text-color-light)');

         a.addEventListener('click', function(e) {
            e.preventDefault();
            const target = document.getElementById(underReviewId);
            if (target) {
                const headerOffset = 70;
                const elementPosition = target.getBoundingClientRect().top;
                const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
                window.scrollTo({ top: offsetPosition, behavior: "smooth" });
            }
        });

        li.appendChild(a);
        list.appendChild(li);
    }
});
</script>
