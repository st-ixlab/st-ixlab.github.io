{% if site.bib_search %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
  <div class="bibsearch-wrapper d-flex flex-wrap align-items-center mb-4" style="gap: 12px;">
    <input type="text" id="bibsearch" spellcheck="false" autocomplete="off" class="search bibsearch-form-input" placeholder="Type to filter" style="margin: 0;">
    <div class="btn-group pub-filter-group" role="group" aria-label="Publication type filter">
      <button type="button" class="btn active" data-filter="all">All</button>
      <button type="button" class="btn" data-filter="journal">Journal</button>
      <button type="button" class="btn" data-filter="conference">Conference</button>
    </div>
  </div>
{% endif %}
